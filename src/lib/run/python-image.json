 "system": [
  "ENV BJ_ANIMATION_FRAMES=600 BJ_ANIMATION_DPI=100",
  "RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*"
 ],
 "datasets": [
  "RUN python -c \"import os, urllib.request as u; [(os.makedirs(os.path.dirname('/opt/bj-datasets/' + p), exist_ok=True), u.urlretrieve('https://' + p, '/opt/bj-datasets/' + p)) for p in ['www.cs.toronto.edu/~kriz/cifar-10-python.tar.gz', 'www.cs.toronto.edu/~kriz/cifar-100-python.tar.gz']]\" || true",
  "RUN python -c \"import keras; [getattr(keras.datasets, n).load_data() for n in ['mnist', 'fashion_mnist', 'cifar10', 'cifar100']]\" || true"
 ]
}
